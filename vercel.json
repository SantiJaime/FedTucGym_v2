{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "dist/app.js",
      "installCommand": "npm ci",
      "buildCommand": "npm run build"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/((?!.*\\.).*)", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
            },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
          ]
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "schedules": {
    "export-sheets": {
      "schedule": "0 3 * * *",
      "timezone": "America/Argentina/Buenos_Aires",
      "path": "/api/cron/export",
      "requestMethod": "GET"
    },
    "update-categories": {
      "schedule": "0 2 1 1 *",
      "timezone": "America/Argentina/Buenos_Aires",
      "path": "/api/cron/categories",
      "requestMethod": "GET"
    }
  }
}
